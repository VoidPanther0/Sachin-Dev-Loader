#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "app.ico"

1 VERSIONINFO
FILEVERSION 1,0,2,0
PRODUCTVERSION 1,0,2,0
FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Sachin Dev"
            VALUE "FileDescription", "Sachin Dev Loader"
            VALUE "FileVersion", "1.0.2.0"
            VALUE "InternalName", "SachinDevLoader"
            VALUE "LegalCopyright", "Copyright (C) 2026 Sachin Dev"
            VALUE "OriginalFilename", "SachinDevLoader.exe"
            VALUE "ProductName", "Sachin Dev Loader"
            VALUE "ProductVersion", "1.0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
